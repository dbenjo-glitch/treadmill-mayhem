# Unity generated folders (never commit these)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Generated at build time by Tools > Treadmill Mayhem > Build WebGL (re-created from the .glb files)
/Assets/TreadmillMayhem/Models/WebTextures/
/Assets/TreadmillMayhem/Models/WebTextures.meta

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE and OS files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
Thumbs.db
Desktop.ini
.DS_Store

# Crash reports and packaged builds
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app
*.zip

# Local presentation captures (copies live in docs/screenshots)
/Slides/

# Burst output left behind by WebGL builds
/Data/
